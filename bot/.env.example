# ── Telegram ──────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to talk to Cici.
# Find your user ID by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=

# Your personal Telegram chat ID. Used for digest delivery.
# Same as your user ID in most cases. Confirm via @userinfobot.
TELEGRAM_OWNER_CHAT_ID=

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Defaults to claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6

# ── OB1 MCP Memory (Supabase Edge Function) ───────────────────────────────────
# From your Supabase project: Functions → open-brain-mcp → URL
OB1_MCP_URL=

# Your MCP_ACCESS_KEY secret (64-char hex). Set via: supabase secrets set MCP_ACCESS_KEY=<key>
OB1_MCP_KEY=

# ── Real-time Data ────────────────────────────────────────────────────────────
# Brave Search API — get a key at https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# OpenWeatherMap — get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Your location for weather (format: "City,CountryCode")
WEATHER_LOCATION=New York,US

# Alpha Vantage (optional, financial data) — https://www.alphavantage.co/support/#api-key
# FINANCIAL_DATA_API_KEY=
